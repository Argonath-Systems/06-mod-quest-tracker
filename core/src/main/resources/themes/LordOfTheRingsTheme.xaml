<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Lord of the Rings Inspired Theme -->
    
    <!-- Colors -->
    <Color x:Key="ColorGold">#FFD700</Color>
    <Color x:Key="ColorDarkGold">#C5A000</Color>
    <Color x:Key="ColorElvenSilver">#C0C0C0</Color>
    <Color x:Key="ColorMordorRed">#8B0000</Color>
    <Color x:Key="ColorParchment">#F5E6C4</Color>
    <Color x:Key="ColorDarkBackground">#1A1A1A</Color>
    <Color x:Key="ColorPanelBackground">#2B2B2B</Color> 
    <Color x:Key="ColorBorder">#444444</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="BrushGold" Color="{StaticResource ColorGold}"/>
    <SolidColorBrush x:Key="BrushDarkGold" Color="{StaticResource ColorDarkGold}"/>
    <SolidColorBrush x:Key="BrushElvenSilver" Color="{StaticResource ColorElvenSilver}"/>
    <SolidColorBrush x:Key="BrushMordorRed" Color="{StaticResource ColorMordorRed}"/>
    <SolidColorBrush x:Key="BrushParchment" Color="{StaticResource ColorParchment}"/>
    <SolidColorBrush x:Key="BrushDarkBackground" Color="{StaticResource ColorDarkBackground}"/>
    <SolidColorBrush x:Key="BrushPanelBackground" Color="{StaticResource ColorPanelBackground}"/>
    <SolidColorBrush x:Key="BrushBorder" Color="{StaticResource ColorBorder}"/>
    <SolidColorBrush x:Key="BrushTextPrimary" Color="White"/>
    <SolidColorBrush x:Key="BrushTextSecondary" Color="#AAAAAA"/>

    <!-- Text Styles -->
    <Style x:Key="HeaderTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Serif"/> <!-- Placeholder for HytaleSerif -->
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource BrushGold}"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="Black" BlurRadius="2" ShadowDepth="2"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SubHeaderTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Serif"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource BrushParchment}"/>
    </Style>

    <Style x:Key="NormalTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
    </Style>

    <!-- Button Styles -->
    <Style x:Key="LotRButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="#333333"/>
        <Setter Property="Foreground" Value="{StaticResource BrushParchment}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BrushGold}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="15,10"/>
        <Setter Property="FontFamily" Value="Serif"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" 
                            BorderBrush="{TemplateBinding BorderBrush}" 
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#444444"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="BorderBrush" Value="{StaticResource BrushElvenSilver}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                             <Setter Property="Background" Value="#222222"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PrimaryButtonStyle" BasedOn="{StaticResource LotRButtonStyle}" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource BrushGold}"/>
        <Setter Property="Foreground" Value="Black"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Style.Triggers>
             <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource BrushDarkGold}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Card/Panel Styles -->
    <Style x:Key="PanelStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BrushPanelBackground}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="2"/>
    </Style>

</ResourceDictionary>
