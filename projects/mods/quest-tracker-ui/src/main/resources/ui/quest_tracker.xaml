<UserControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="250" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,50,20,0">
    
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../themes/LordOfTheRingsTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel x:Name="quest_list_container">
        <!-- Default Content -->
        <Border Background="{StaticResource BrushDarkBackground}" CornerRadius="4" Padding="10" Margin="0,0,0,5" BorderBrush="{StaticResource BrushGold}" BorderThickness="1">
             <TextBlock Text="No Quests Tracked" Style="{StaticResource HeaderTextStyle}" FontSize="18"/>
        </Border>
    </StackPanel>
</UserControl>
