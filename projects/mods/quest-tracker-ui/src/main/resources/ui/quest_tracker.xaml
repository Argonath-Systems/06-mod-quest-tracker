<!--
    Quest Tracker HUD - HYUIML Format
    Uses HyUI HudBuilder conventions
    Displays tracked quests in a floating panel on the right side of the screen
    
    Supported tags: div, p, label, button
    Supported styles: layout-mode, anchor-*, font-size, color, background
-->
<div id="quest_tracker_hud" style="anchor-right: 20; anchor-top: 50; anchor-width: 250; layout-mode: Top;">
    
    <!-- Quest List Container -->
    <div id="quest_list_container" style="layout-mode: Top;">
        
        <!-- Default empty state -->
        <div id="quest_empty_state" class="quest-card" 
             style="background: rgba(20,15,10,0.85); anchor-width: 250; anchor-height: 50; layout-mode: Top;">
            <div style="anchor-left: 10; anchor-right: 10; anchor-top: 10;">
                <label style="font-size: 16; color: #FFD700;">No Quests Tracked</label>
            </div>
        </div>
        
    </div>
    
</div>
